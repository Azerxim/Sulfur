{
  "name": "@azerxim/sulfur-sdk",
  "version": "1.2.0",
  "description": "SDK des modules Sulfur : contrat des modules, traductions, points de données et composants d'interface partagés",
  "license": "Apache-2.0",
  "author": "Maxime MALLET <mallet.maxime@topazdev.fr>",
  "homepage": "https://github.com/Azerxim/Sulfur/tree/main/packages/sdk",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Azerxim/Sulfur.git",
    "directory": "packages/sdk"
  },
  "type": "module",
  "sideEffects": [
    "./src/locales/*",
    "./src/ui/module-config.js",
    "./src/index.js",
    "./src/main/index.js",
    "./src/ui/index.js",
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.js"
    },
    "./main": {
      "types": "./types/main.d.ts",
      "default": "./src/main/index.js"
    },
    "./ui": {
      "types": "./types/ui.d.ts",
      "default": "./src/ui/index.js"
    },
    "./host": {
      "types": "./types/host.d.ts",
      "default": "./src/host/index.js"
    },
    "./build": {
      "types": "./types/build.d.ts",
      "default": "./src/build/index.js"
    },
    "./archive": {
      "types": "./types/archive.d.ts",
      "default": "./src/archive.js"
    },
    "./theme.css": "./src/ui/theme.css",
    "./module.css": "./src/ui/module.css",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "types",
    "README.md",
    "README.fr.md",
    "ROADMAP.md",
    "ROADMAP.fr.md"
  ],
  "peerDependencies": {
    "@fortawesome/fontawesome-svg-core": ">=7.0.0",
    "@fortawesome/free-solid-svg-icons": ">=7.0.0",
    "@fortawesome/react-fontawesome": ">=3.0.0",
    "@peculiar/x509": "^2.1.0",
    "react": "^19.0.0",
    "reflect-metadata": "^0.2.2",
    "tailwindcss": "^4.0.0",
    "vite": ">=6.0.0"
  },
  "peerDependenciesMeta": {
    "@fortawesome/fontawesome-svg-core": {
      "optional": true
    },
    "@fortawesome/free-solid-svg-icons": {
      "optional": true
    },
    "@fortawesome/react-fontawesome": {
      "optional": true
    },
    "@peculiar/x509": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "reflect-metadata": {
      "optional": true
    },
    "tailwindcss": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
