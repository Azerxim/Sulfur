{
  "name": "sulfur",
  "version": "0.4.0",
  "description": "Sulfur - application de simulation modulaire (Electron + React + TailwindCSS)",
  "main": "./out/main/index.js",
  "desktopName": "sulfur.desktop",
  "author": "Maxime MALLET <mallet.maxime@topazdev.fr>",
  "license": "Apache-2.0",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dist": "npm run build && electron-builder --publish never",
    "dist:linux": "npm run build && electron-builder --linux --publish never",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist:mac": "npm run build && electron-builder --mac --publish never"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "@peculiar/x509": "^2.1.0",
    "electron-updater": "^6.8.9",
    "mqtt": "^5.16.0",
    "mqtt-packet": "^9.0.2",
    "net-snmp": "^3.29.1",
    "node-opcua": "^2.186.17",
    "node-opcua-crypto": "^6.1.4",
    "reflect-metadata": "^0.2.2",
    "serialport": "^13.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^5.2.0",
    "@xyflow/react": "^12.12.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "lucide-react": "^1.52.0",
    "prettier": "^3.9.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "uplot": "^1.6.32",
    "vite": "^7.3.7",
    "vitest": "^5.0.3"
  },
  "homepage": "https://github.com/Azerxim/Sulfur",
  "allowScripts": {
    "electron@44.5.1": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "electron-winstaller@5.4.0": true,
    "@serialport/bindings-cpp@13.0.0": true
  }
}
