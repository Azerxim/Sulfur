{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "checkJs": false,
    "baseUrl": ".",
    "paths": {
      "@azerxim/sulfur-sdk": ["packages/sdk/src/index.js"],
      "@azerxim/sulfur-sdk/*": ["packages/sdk/src/*/index.js"],
      "@renderer/*": ["src/renderer/src/*"],
      "@shared/*": ["src/shared/*"],
      "@modules/*": ["src/modules/*"]
    }
  },
  "include": ["src/**/*", "packages/sdk/src/**/*", "electron.vite.config.mjs"],
  "exclude": ["node_modules", "out", "dist"]
}
